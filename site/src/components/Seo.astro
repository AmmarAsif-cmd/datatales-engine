---
import { SITE } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  /** Path or absolute URL. Defaults to the site default image. */
  image?: string;
  imageAlt?: string;
  /** Pixel size of `image`, when known (story covers are 1200×630). */
  imageSize?: [number, number];
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = SITE.defaultOgImage,
  imageAlt = SITE.name,
  imageSize,
  type = 'website',
  published,
  modified,
  noindex = false,
  jsonLd,
} = Astro.props;

// Canonical: no trailing slash, no .html; the home page is the bare origin.
const path = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/\/index$/, '')
  .replace(/\/$/, '');
const canonical = path ? new URL(path, SITE.url).href : SITE.url;
const imageUrl = new URL(image, SITE.url).href;
// The home page gets the tagline too, so search results say what the site is.
const fullTitle =
  title === SITE.name
    ? `${SITE.name}: ${SITE.tagline.replace(/\.$/, '')}`
    : `${title} | ${SITE.name}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const toJson = (obj: unknown) => JSON.stringify(obj).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{imageSize && <meta property="og:image:width" content={String(imageSize[0])} />}
{imageSize && <meta property="og:image:height" content={String(imageSize[1])} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{modified && <meta property="article:modified_time" content={modified.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{ld.map((obj) => (
  <script type="application/ld+json" set:html={toJson(obj)} />
))}
