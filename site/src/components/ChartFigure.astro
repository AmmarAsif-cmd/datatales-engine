---
import Chart from './Chart';
import { colouredSeries, type ChartSpec, type Row } from '../lib/chart';
import { chartAlt, type ChartFacts, type Spec } from '../lib/graphics/alt.ts';
import { renderStaticChart } from '../lib/charts/static.ts';
import { enDash } from '../lib/story';

interface Props {
  spec: ChartSpec;
  data: Row[];
  /** Used as the chart's accessible name when the spec has no title. */
  fallbackTitle: string;
  /** Verified chart facts (numbers.chart_facts), used in the alt text. */
  facts?: ChartFacts;
  /** Unique per page. */
  index?: number;
}

const { spec, data, fallbackTitle, facts, index = 0 } = Astro.props;
const title = enDash(spec.title ?? fallbackTitle);
const alt = chartAlt(spec as Spec, data, title, facts);
const id = `chart-${index + 1}`;
const staticSvg = renderStaticChart(spec as Spec, data, { title, describedBy: `${id}-desc` });
const coloured =
  spec.type === 'line' || spec.type === 'bar' || spec.type === 'dot'
    ? colouredSeries(spec, data)
    : [];
const hasOthers =
  !!spec.series && new Set(data.map((r) => String(r[spec.series!]))).size > coloured.length;
---

<figure class="chart" aria-labelledby={`${id}-title`}>
  <figcaption>
    <p class="chart-title" id={`${id}-title`}>
      {title}
    </p>
    <p class="chart-sub">{spec.yLabel ?? spec.y}</p>
    {coloured.length >= 2 && (
      <ul class="legend" aria-label="Legend">
        {coloured.map((s, i) => (
          <li>
            <span class="key" style={`background: var(--series-${i + 1})`} />
            {s}
          </li>
        ))}
        {hasOthers && (
          <li>
            <span class="key" style="background: var(--chart-muted)" />
            Other
          </li>
        )}
      </ul>
    )}
  </figcaption>

  <div class="chart-frame">
    {staticSvg ? (
      <div class="static-frame" set:html={staticSvg} />
    ) : (
      <Chart client:visible spec={spec} data={data} label={title} describedBy={`${id}-desc`} />
    )}
  </div>

  {spec.annotation && <p class="chart-note">{enDash(spec.annotation)}</p>}
  <p class="visually-hidden" id={`${id}-desc`}>
    {alt}
  </p>
</figure>

<style>
  .chart {
    margin: 2rem 0;
    padding: 1.25rem 1rem 1rem;
    background: var(--chart-surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }
  figcaption p {
    margin: 0;
  }
  .chart-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .chart-sub {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .key {
    display: inline-block;
    width: 14px;
    height: 3px;
    border-radius: 2px;
  }
  .chart-frame {
    margin-top: 0.75rem;
    min-height: 260px; /* reserve space before the island hydrates */
  }
  .chart-note {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .static-frame {
    display: flex;
    justify-content: center;
  }
  .static-frame :global(svg) {
    width: 100%;
    height: auto;
    max-width: 34rem;
    max-height: 42rem;
  }
  .static-frame :global(svg title) {
    pointer-events: none;
  }
</style>
