---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChartFigure from '../../components/ChartFigure.astro';
import NumberCards from '../../components/NumberCards.astro';
import SourceNote from '../../components/SourceNote.astro';
import type { Row } from '../../lib/chart';
import { formatDate, getPosts, getStories, type Story } from '../../lib/content';
import { SITE } from '../../lib/site';
import { enDash, periodRange } from '../../lib/story';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props as { story: Story };
const { Content } = await render(story);
const d = story.data;
const url = `${SITE.url}/stories/${story.id}`;
const ogImage = `/stories/${story.id}.png`;
const range = periodRange(d.chart_data as Row[], d.chart_spec.x);
const covers = range ? `${enDash(range[0])} to ${enDash(range[1])}` : d.period && enDash(d.period);

// Related: other stories and posts built on the same source dataset.
const related = [
  ...(await getStories())
    .filter((s) => s.id !== story.id && s.data.source.url === d.source.url)
    .map((s) => ({
      title: s.data.title,
      url: `/stories/${s.id}`,
      kind: 'Story',
      date: s.data.date,
    })),
  ...(await getPosts())
    .filter((p) => p.data.sources.includes(d.source.url))
    .map((p) => ({ title: p.data.title, url: `/${p.id}`, kind: 'Article', date: p.data.date })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  url,
  mainEntityOfPage: url,
  image: new URL(ogImage, SITE.url).href,
  inLanguage: 'en-GB',
  author: { '@type': 'Person', name: SITE.author },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: new URL(SITE.logo, SITE.url).href },
  },
  isBasedOn: d.source.url,
};
const dataset = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: d.source.name,
  url: d.source.url,
  description: `Source dataset for “${d.title}”.`,
  creator: d.source.publisher ? { '@type': 'Organization', name: d.source.publisher } : undefined,
  license: d.source.licence,
  temporalCoverage: covers,
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'text/csv',
    contentUrl: `${url}.csv`,
  },
};
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
  image={ogImage}
  imageAlt={`Chart: ${enDash(d.chart_spec.title ?? d.title)}`}
  published={d.date}
  modified={d.updated}
  noindex={d.sample}
  jsonLd={d.sample ? undefined : [article, dataset]}
>
  <article class="container">
    <div class="measure">
      {d.sample && (
        <p class="sample-banner" role="note">
          SAMPLE STORY: made-up numbers for layout testing only. This page is never built for the
          live site.
        </p>
      )}
      <header class="head">
        <p class="kicker">Data story</p>
        <h1>{enDash(d.title)}</h1>
        {covers && <p class="covers">Data covers {covers}</p>}
        <p class="hook">{enDash(d.hook)}</p>
        <p class="meta">
          By {SITE.author}
          {' · '}
          <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
          {d.updated && formatDate(d.updated) !== formatDate(d.date) && (
            <>
              {' '}
              · Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time>
            </>
          )}
          {' · '}Source:{' '}
          <a href={d.source.url} rel="noopener">
            {d.source.name}
          </a>
        </p>
      </header>
    </div>

    <div class="wide-chart">
      <ChartFigure
        spec={d.chart_spec}
        data={d.chart_data as Row[]}
        fallbackTitle={d.title}
        csvHref={`/stories/${story.id}.csv`}
        csvName={`datatales-${story.id}.csv`}
      />
    </div>

    <div class="measure">
      <NumberCards
        items={d.keyNumbers.map((k) => ({
          ...k,
          label: enDash(k.label),
          note: k.note && enDash(k.note),
        }))}
      />
      <div class="prose">
        <Content />
      </div>
      <SourceNote
        source={d.source}
        fetchedAt={d.fetchedAt}
        recipeVersion={d.recipeVersion}
        datasetChecksum={d.datasetChecksum}
        period={covers}
        updated={d.updated ?? d.date}
      />
      {related.length > 0 && (
        <nav class="related" aria-labelledby="related-heading">
          <h2 id="related-heading">More from this data</h2>
          <ul>
            {related.map((r) => (
              <li>
                <span class="kind">{r.kind}</span>
                <a href={r.url}>{enDash(r.title)}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding: 2.5rem 0 0.5rem;
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.7rem);
    margin: 0 0 0.5rem;
  }
  .covers {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .hook {
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0 0 0.75rem;
  }
  .wide-chart {
    max-width: 52rem;
    margin-inline: auto;
  }
  .related {
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .related h2 {
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
  }
  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .related li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }
  .kind {
    flex: none;
    min-width: 4.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
</style>
