# Cloudflare static-asset redirects: old Hashnode paths -> new site.
# /archive and /rss.xml exist natively at the same paths, so they need no redirect.
# Static rules must come before splat (*) rules.
/sitemap-index.xml  /sitemap.xml  301
/members            /             301
/newsletter         /             301
/series/*           /archive      301
/tag/*              /archive      301
