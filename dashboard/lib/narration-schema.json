{
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "description": "10 to 70 characters: the single strongest finding as a statement"
    },
    "hook": {
      "type": "string",
      "description": "exactly one full sentence"
    },
    "summary": {
      "type": "string",
      "description": "2 to 4 sentences, at most 120 words"
    },
    "body_md": {
      "type": "string",
      "description": "Markdown, 500 to 700 words, with '## How it compares' and '## What the data can't tell us'"
    },
    "video_script": {
      "type": "string",
      "description": "at most 90 words, to be read aloud"
    },
    "chart_spec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "line",
            "bar",
            "dot",
            "slope",
            "map"
          ]
        },
        "x": {
          "type": "string",
          "description": "period column, normally 'period'"
        },
        "y": {
          "type": "string",
          "description": "value column, normally 'value'"
        },
        "series": {
          "type": "string",
          "description": "geography column: 'geography'"
        },
        "highlight": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "geographies to highlight ([] for none)"
        },
        "annotation": {
          "type": "string",
          "description": "short note under the chart (\"\" if not used)"
        },
        "title": {
          "type": "string",
          "description": "short chart title (\"\" if not used)"
        },
        "yLabel": {
          "type": "string",
          "description": "unit label, e.g. '% of people' (\"\" if not used)"
        },
        "start": {
          "type": "string",
          "description": "slope only: first period (\"\" if not used)"
        },
        "end": {
          "type": "string",
          "description": "slope only: last period (\"\" if not used)"
        },
        "period": {
          "type": "string",
          "description": "map only: the period shown (\"\" if not used)"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "series",
        "highlight",
        "annotation",
        "title",
        "yLabel",
        "start",
        "end",
        "period"
      ],
      "additionalProperties": false
    },
    "more_charts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "line",
              "bar",
              "dot",
              "slope",
              "map"
            ]
          },
          "x": {
            "type": "string",
            "description": "period column, normally 'period'"
          },
          "y": {
            "type": "string",
            "description": "value column, normally 'value'"
          },
          "series": {
            "type": "string",
            "description": "geography column: 'geography'"
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "geographies to highlight ([] for none)"
          },
          "annotation": {
            "type": "string",
            "description": "short note under the chart (\"\" if not used)"
          },
          "title": {
            "type": "string",
            "description": "short chart title (\"\" if not used)"
          },
          "yLabel": {
            "type": "string",
            "description": "unit label, e.g. '% of people' (\"\" if not used)"
          },
          "start": {
            "type": "string",
            "description": "slope only: first period (\"\" if not used)"
          },
          "end": {
            "type": "string",
            "description": "slope only: last period (\"\" if not used)"
          },
          "period": {
            "type": "string",
            "description": "map only: the period shown (\"\" if not used)"
          }
        },
        "required": [
          "type",
          "x",
          "y",
          "series",
          "highlight",
          "annotation",
          "title",
          "yLabel",
          "start",
          "end",
          "period"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sentence": {
            "type": "string",
            "description": "a sentence copied exactly from the text fields"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "highest",
                    "lowest",
                    "only_rise",
                    "only_fall",
                    "all_rise",
                    "all_fall",
                    "biggest_rise",
                    "biggest_fall"
                  ]
                },
                "group": {
                  "type": "string",
                  "description": "geography; not used for all_rise/all_fall (\"\" if not used)"
                },
                "period": {
                  "type": "string",
                  "description": "highest/lowest only: the period (\"\" if not used)"
                },
                "start": {
                  "type": "string",
                  "description": "rise/fall kinds only: first period (\"\" if not used)"
                },
                "end": {
                  "type": "string",
                  "description": "rise/fall kinds only: last period (\"\" if not used)"
                }
              },
              "required": [
                "kind",
                "group",
                "period",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sentence",
          "keys",
          "checks"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "one claim for EVERY sentence in any field that contains a number or a rank word, usually 20 to 40 for a full story"
    }
  },
  "required": [
    "headline",
    "hook",
    "summary",
    "body_md",
    "video_script",
    "chart_spec",
    "more_charts",
    "claims"
  ],
  "additionalProperties": false
}
