{
  "name": "datatales-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "build:cf": "node scripts/guard-env-files.mjs && opennextjs-cloudflare build && node scripts/check-bundle.mjs",
    "deploy": "npm run build:cf && opennextjs-cloudflare deploy",
    "preview": "npm run build:cf && opennextjs-cloudflare preview",
    "smoke:cf": "node scripts/smoke-preview.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@observablehq/plot": "^0.6.17",
    "@opennextjs/cloudflare": "^1.20.10",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5",
    "wrangler": "4.149.0"
  }
}
