# Copy to worker/.env and fill in. Never commit the real file.
# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role key: bypasses RLS. Only the worker (local .env / GitHub Actions secret)
# and the local dashboard may hold it.
SUPABASE_SERVICE_ROLE_KEY=
# Claude API key (Phase 2). Production: GitHub Actions secret / Worker secret.
ANTHROPIC_API_KEY=
